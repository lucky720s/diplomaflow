# managed-by-cd: true (на сервере)
ENV_FILE_VERSION=2

ENV=dev
GIN_MODE=release

# Required secrets (server .env will have real values)
JWT_SECRET=
POSTGRES_PASSWORD=

POSTGRES_USER=diplomaflow
POSTGRES_DB=diplomaflow

# inside docker network
POSTGRES_PORT=5432

# host port (to avoid conflict with other service on 5432)
POSTGRES_HOST_PORT=5433

# For Go services (keyword DSN)
DATABASE_DSN=host=main_postgres user=diplomaflow password=changeme dbname=diplomaflow port=5432 sslmode=disable TimeZone=UTC

# For migrations ONLY (URL with scheme)
DATABASE_URL=postgres://diplomaflow:changeme@main_postgres:5432/diplomaflow?sslmode=disable

REDIS_ADDR=redis:6379

KAFKA_BROKERS=kafka:29092
KAFKA_GROUP_ID=diplomaflow-group
KAFKA_KRAFT_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

PORT_GATEWAY=8080

# Optional: bind gateway to 0.0.0.0 or 127.0.0.1
GATEWAY_BIND_ADDR=0.0.0.0
