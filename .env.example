# managed-by-cd: true (на сервере)
ENV_FILE_VERSION=2

ENV=dev
GIN_MODE=release
METRICS_PORT=9090
GRAFANA_ADMIN_PASSWORD=__SET_ME__
# Required secrets (server .env will have real values)


POSTGRES_USER=diplomaflow
POSTGRES_DB=diplomaflow

# inside docker network
POSTGRES_PORT=5432

# host port (to avoid conflict with other service on 5432)
POSTGRES_HOST_PORT=5433

POSTGRES_PASSWORD=your_secure_password
DATABASE_DSN=host=main_postgres user=diplomaflow password=your_secure_password dbname=diplomaflow port=5432 sslmode=disable TimeZone=UTC
DATABASE_URL=postgres://diplomaflow:your_secure_password@main_postgres:5432/diplomaflow?sslmode=disable
JWT_SECRET=your_jwt_secret
REDIS_ADDR=redis:6379


PORT_GATEWAY=8080

# Optional: bind gateway to 0.0.0.0 or 127.0.0.1
GATEWAY_BIND_ADDR=0.0.0.0
