# managed-by-cd: true
ENV_FILE_VERSION=1

# App
ENV=dev
GIN_MODE=release
METRICS_PORT=9090
GRAFANA_ADMIN_PASSWORD=__SET_ME__

# Secrets (на сервере заполняются из GitHub Secrets через CD)
JWT_SECRET=__SET_IN_GITHUB_SECRETS__
POSTGRES_PASSWORD=__SET_IN_GITHUB_SECRETS__

# Postgres (внутри docker-сети всегда 5432)
POSTGRES_USER=diplomaflow
POSTGRES_DB=diplomaflow
POSTGRES_PORT=5432

# Postgres host port (только для подключения с сервера: 127.0.0.1:5433)
POSTGRES_HOST_PORT=5433

DATABASE_DSN=host=main_postgres user=diplomaflow password=__SET_IN_GITHUB_SECRETS__ dbname=diplomaflow port=5432 sslmode=disable TimeZone=UTC
DATABASE_URL=postgres://diplomaflow:__SET_IN_GITHUB_SECRETS__@main_postgres:5432/diplomaflow?sslmode=disable

# Redis
REDIS_ADDR=redis:6379

# Ports
PORT_GATEWAY=8080
PORT_UNIVERSITY=8081
PORT_AUTH=8082
PORT_PROJECT=8083
PORT_TEAM=8084
PORT_WORKFLOW=8085
PORT_ROLE=8086
PORT_NOTIFICATION=8087
PORT_FILE=8088
PORT_FORM=8089
PORT_ADMIN=8090
PORT_TASK=8091

# Service discovery inside compose
SERVICES_AUTH_ADDR=auth_service:8082
SERVICES_UNIVERSITY_ADDR=university_service:8081
SERVICES_PROJECT_ADDR=project_service:8083
SERVICES_TEAM_ADDR=team_service:8084
SERVICES_WORKFLOW_ADDR=workflow_service:8085
SERVICES_ROLE_ADDR=role_service:8086
SERVICES_NOTIFICATION_ADDR=notification_service:8087
SERVICES_FILE_ADDR=file_service:8088
SERVICES_FORM_ADDR=form_service:8089
SERVICES_ADMIN_ADDR=admin_service:8090
SERVICES_TASK_ADDR=task_service:8091

# Auth settings
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
